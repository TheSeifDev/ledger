# Neon PostgreSQL — connection strings for the branch checked out with the
# Neon CLI (`neon checkout <branch>` updates these values).
DATABASE_URL=
DATABASE_URL_POOLED=
DATABASE_URL_UNPOOLED=

# Name of the Neon branch the URLs above point at — drives the migration
# safety gate in drizzle.config.ts.
NEON_BRANCH=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Set to "true" only for a single, reviewed production migration run.
# ALLOW_PRODUCTION_MIGRATIONS=
