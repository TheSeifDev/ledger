# PHANTOMS Ledger — environment template.
# Copy to .env and fill in real values. Never commit real values.

# ── Neon PostgreSQL ────────────────────────────────────────────────────────
# Take connection strings from the Neon dashboard for the branch you are
# working on. Develop against a DEVELOPMENT branch — never against the
# production branch for local migration experimentation.
DATABASE_URL=

# Pooled (PgBouncer) — used by the application runtime
# (db/index.ts, lib/auth.ts).
DATABASE_URL_POOLED=

# Unpooled (direct) — used by drizzle-kit for migrations (drizzle.config.ts).
DATABASE_URL_UNPOOLED=

# Name of the Neon branch the values above target.
# Migrations refuse to run when this is "production".
NEON_BRANCH=development

# ── Better Auth ────────────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000

# ── Migration safety override ───────────────────────────────────────────────
# Only for reviewed, intentional production migrations. Leave unset otherwise.
# ALLOW_PRODUCTION_MIGRATIONS=true
